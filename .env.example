# Copy this file to .env (same folder) and adjust. .env is git-ignored:

# --- Local Docker databases (docker compose up -d) -------------------------
# These local credentials are not secret: the containers only listen on
# your own machine.
DATABASE_URL=postgresql://resalewise:resalewise@127.0.0.1:5433/resalewise
MONGO_URI=mongodb://127.0.0.1:27018
MONGO_DB=hdb

# --- OR the cloud databases (Neon + MongoDB Atlas) --------------------------
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=resalewise

# --- Login tokens -------------------------------------------------------------
# Required. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET=replace-with-a-long-random-string

# admin page: sign in as `admin`. Without ADMIN_PASSWORD the password is the demo one in
# USER_MANUAL.md, fine on your own machine since the admin page can only read and write its
# own sample table. On a public site set your own:
# ADMIN_PASSWORD=choose-a-long-password

# --- Optional -------------------------------------------------------------------
# FLASK_DEBUG=1             # development only: auto-reload + debugger
# CORS_ORIGINS=*            # lock to your site's origin in production
# RATE_LIMIT_PER_MIN=300
